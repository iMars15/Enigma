{
  "name": "enigma-messenger",
  "version": "0.1.0",
  "description": "Open-source Discord-style messenger with PHP API, Node.js WebSocket, SQLite, and WebRTC signaling.",
  "private": true,
  "type": "module",
  "scripts": {
    "php": "node start-php.js",
    "ws": "node server/ws-server.js",
    "dev": "concurrently \"npm run php\" \"npm run ws\""
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^16.1.4",
    "ws": "^8.18.0"
  }
}
